# Copy to .env and fill in. Every setting has a default that works on localhost.

PORT=5180
# production turns on https cookies and turns off the example people.
# NODE_ENV=production

# You, the super admin. Named here and only here: the app itself can never
# create, promote or demote a super admin. In production the password must
# be at least 16 characters, or the server won't start.
SUPER_ADMIN_EMAIL=super@localhost
SUPER_ADMIN_NAME=Super admin
# SUPER_ADMIN_PASSWORD=a-long-passphrase-you-dont-use-anywhere-else

# Super admin sessions end after this many hours (everyone else: SESSION_DAYS).
# SUPER_SESSION_HOURS=8
# SESSION_DAYS=30

# Anyone can sign up (on by default).
# OPEN_SIGNUP=true

# Behind a host's proxy (Fly.io, Render, Caddy): read visitors' addresses from it.
# TRUST_PROXY=true

# Where the database lives. Back this folder up.
# DATA_DIR=data

# Add the example people (kemi, ade, mira) on first start. On by default except in production.
# SEED_EXAMPLES=true
